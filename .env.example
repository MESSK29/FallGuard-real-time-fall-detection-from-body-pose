# FallGuard Environment Configuration

# Application Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Camera / Video Feed Settings
# 0 for default internal laptop webcam, 1 for external USB camera, or RTSP/file path
CAMERA_INDEX=0
CAMERA_FPS=30

# Fall Detection Model Settings
MODEL_PATH=models/fall_detector_xgboost.joblib
FALL_CONFIDENCE_THRESHOLD=0.70
LYING_STILL_CONFIRMATION_SECONDS=2.0

# Alert / Notification Settings (Telegram Bot API & Webhook)
ALERT_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TIMEZONE=Asia/Kolkata

# Incident Video Clip Settings (Requires ffmpeg; set custom path if not in system PATH)
FFMPEG_PATH=
